@page "/media"
@rendermode InteractiveServer

<PageTitle>Calculadora de Média</PageTitle>

<h1>Calculadora de Média</h1>

<div class="mb-3">
    <label for="nota1" class="form-label">
        Nota 1:
    </label>

    <input id="nota1"
           type="number"
           step="0.1"
           class="form-control"
           @bind="nota1" />
</div>

<div class="mb-3">
    <label for="nota2" class="form-label">
        Nota 2:
    </label>

    <input id="nota2"
           type="number"
           step="0.1"
           class="form-control"
           @bind="nota2" />
</div>

<button class="btn btn-primary" @onclick="CalcularMedia">
    Calcular Média
</button>

@if (media.HasValue)
{
    <div class="mt-3">

        <p>
            Média:
            <strong>@media.Value.ToString("F2")</strong>
        </p>

        @if (media.Value >= 7.0)
        {
            <p>
                <strong>Aprovado!</strong>
            </p>
        }
        else
        {
            <p class="text-danger">
                <strong>Reprovado!</strong>
            </p>
        }

    </div>
}

@code {
    double nota1;
    double nota2;
    double? media = null;

    void CalcularMedia()
    {
        media = (nota1 + nota2) / 2;
    }
}